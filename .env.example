# Environment Configuration Template
# Copy this file to .env and fill in actual values.
#
# Every active key below is read by backend/app/config.py (python-dotenv +
# os.getenv) at application startup. Names and default values match the code
# exactly; real environment variables always override values set here.

# Backend server (Config.API_HOST / Config.API_PORT)
# Set API_HOST=127.0.0.1 to restrict access to this machine only.
API_HOST=0.0.0.0
API_PORT=8000

# Runtime environment (Config.ENVIRONMENT)
ENVIRONMENT=development

# Ollama server (Config.OLLAMA_BASE_URL)
OLLAMA_BASE_URL=http://localhost:11434

# LLM answer generation (Config.LLM_MODEL / Config.LLM_TEMPERATURE / Config.LLM_MAX_TOKENS)
LLM_MODEL=qwen3:4b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500

# Embeddings via Ollama (Config.EMBEDDING_MODEL / Config.EMBEDDING_DIMENSION)
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIMENSION=768

# ChromaDB storage (Config.CHROMA_DB_PATH; relative paths resolve from the
# working directory used to start the server)
CHROMA_DB_PATH=backend/chroma_db

# --- Planned settings (commented out: not read by any code yet) ---
# Local-embedding path, to be wired up in a future phase. sentence-transformers
# is listed in requirements.txt, but no backend code consumes these today.
# EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# EMBEDDINGS_DEVICE=cpu
